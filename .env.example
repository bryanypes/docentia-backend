# Copia este archivo a .env solo si quieres cambiar los valores de desarrollo.
# docker compose up --build ya arranca con estos mismos valores por defecto.

# PostgreSQL (servicio db). El puerto del host es 5433 para no chocar con un Postgres local.
# Dentro de la red de Compose la API sigue usando db:5432.
POSTGRES_USER=docentia
POSTGRES_PASSWORD=docentia
POSTGRES_DB=docentia
POSTGRES_PORT=5433

# Backend (servicio api). Perfil dev: usuarios de ejemplo y modelo de IA simulado.
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DOCENTIA_JWT_SECRETO=secreto-de-desarrollo-local-no-usar-en-produccion
# Mismo Client ID de Google Cloud (OAuth 2.0, aplicación web). El secret GOCSPX no se usa aquí.
DOCENTIA_GOOGLE_CLIENT_ID=
DOCENTIA_IA_HABILITADO=true
# local = modelo por reglas, sin red (por defecto). Para un proveedor externo: chat-completions,
# con su URL y modelo; los comentarios salen anonimizados. La clave solo va en .env, nunca aquí.
DOCENTIA_IA_PROVEEDOR=local
DOCENTIA_IA_URL_BASE=
DOCENTIA_IA_MODELO=
DOCENTIA_IA_CLAVE=

# Frontend (servicio web). Nginx sirve la app y reenvía /api al backend.
WEB_PORT=5173
VITE_GOOGLE_CLIENT_ID=

# Resolución 074
DOCENTIA_COMPROMISOS_UMBRAL=3.8
DOCENTIA_ACTAS_ROL_CORRECTOR=VICERRECTOR

# Notificaciones. Con Docker los correos van a Mailpit (http://localhost:8025).
# Fuera de desarrollo usa tu SMTP con TLS y deja la clave solo en .env.
DOCENTIA_APP_URL=http://localhost:5173
MAILPIT_PORT=8025
DOCENTIA_MAIL_HOST=mailpit
DOCENTIA_MAIL_PORT=1025
DOCENTIA_MAIL_USER=
DOCENTIA_MAIL_PASS=
DOCENTIA_MAIL_FROM=no-responder@uniautonoma.edu.co
DOCENTIA_MAIL_TLS=false
